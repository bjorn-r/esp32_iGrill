# WiFi Configuration
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Optional: Secondary WiFi network
wifi_ssid2: "SecondarySSID"
wifi_password2: "SecondaryPassword"

# MQTT Configuration (optional - only if not using Home Assistant API)
mqtt_broker: "192.168.1.100"
mqtt_port: "1883"
mqtt_username: "mqtt"
mqtt_password: "mqtt_password"

# Home Assistant API
# Generate with: esphome <your-config>.yaml compile
api_encryption_key: "your-32-character-encryption-key-here"

# OTA Updates
ota_password: "secure_ota_password"

# Optional: Specify iGrill MAC address (leave blank for auto-discovery)
igrill_mac_address: ""  # Format: "AA:BB:CC:DD:EE:FF"
